{
  "name": "trustpay-solana",
  "private": true,
  "workspaces": [
    "app"
  ],
  "scripts": {
    "build": "npm run build -w app",
    "test": "ts-mocha -p tsconfig.json -t 1000000 tests/**/*.ts",
    "test:chain": "anchor test",
    "sync:idl": "node scripts/sync-idl.mjs",
    "test:browser": "node tests/browser.mjs",
    "defi:setup": "ts-node -P tsconfig.json scripts/week09-setup.ts",
    "test:defi": "ts-mocha -p tsconfig.json tests/defi-math.ts",
    "test:defi:devnet": "TRUSTPAY_DEFI_DEVNET=1 ts-mocha -p tsconfig.json -t 240000 tests/defi-devnet.ts",
    "test:defi:local": "TRUSTPAY_DEFI_LOCAL=1 ts-mocha -p tsconfig.json -t 180000 tests/defi-local.ts",
    "test:defi:browser": "node tests/browser-defi.mjs",
    "test:defi:browser:transactions": "TRUSTPAY_DEFI_BROWSER=1 node tests/browser-defi-transactions.mjs",
    "test:rpc": "ts-mocha -p tsconfig.json tests/rpc.ts",
    "test:dashboard:local": "TRUSTPAY_DASHBOARD_NETWORK=localnet node tests/browser-dashboard.mjs",
    "test:dashboard:devnet": "TRUSTPAY_DASHBOARD_NETWORK=devnet node tests/browser-dashboard.mjs",
    "deploy:week10:devnet": "node scripts/week10-deploy.mjs",
    "test:vault:devnet": "TRUSTPAY_WEEK10_DEVNET=1 ts-mocha -p tsconfig.json -t 240000 tests/liquidity-devnet.ts",
    "deploy:week10:resume": "node scripts/week10-resume.mjs",
    "test:market": "ts-mocha -p tsconfig.json tests/market-math.ts",
    "test:market:devnet": "TRUSTPAY_WEEK11_DEVNET=1 ts-mocha -p tsconfig.json -t 180000 tests/market-devnet.ts",
    "test:market:browser": "node tests/browser-liquidity.mjs",
    "test:swap": "ts-mocha -p tsconfig.json tests/swap.ts",
    "test:swap:rpc": "node scripts/week12-check.mjs",
    "test:swap:devnet": "TRUSTPAY_SWAP_DEVNET=1 node scripts/week12-swap-devnet.mjs",
    "test:swap:browser": "node tests/browser-swap.mjs",
    "build:security": "node scripts/week12-build-lab.mjs",
    "test:security": "node tests/security-lab.mjs",
    "test:unit": "ts-mocha -p tsconfig.json tests/defi-math.ts tests/market-math.ts tests/rpc.ts tests/swap.ts tests/wallet-signing.ts",
    "test:phantom:request": "node tests/phantom-request.mjs",
    "verify:swap": "node scripts/week12-verify-swaps.mjs",
    "test:week13": "ts-mocha -p tsconfig.json tests/week13.ts",
    "setup:week13": "node scripts/week13-setup.mjs",
    "test:week13:payments:devnet": "TRUSTPAY_WEEK13_DEVNET=1 node scripts/week13-payments-devnet.mjs",
    "test:week13:clmm:devnet": "TRUSTPAY_WEEK13_DEVNET=1 node scripts/week13-clmm-devnet.mjs",
    "test:week13:browser": "node tests/browser-week13.mjs",
    "verify:week13": "node scripts/week13-verify.mjs"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@raydium-io/raydium-sdk-v2": "0.2.81-alpha",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "bn.js": "5.2.2",
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "chai": "^4.5.0",
    "mocha": "^11.7.0",
    "playwright": "1.64.1",
    "ts-mocha": "^11.1.0",
    "ts-node": "10.9.2",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
