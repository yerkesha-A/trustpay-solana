# Copy to app/.env.local. Only localhost or Solana Devnet.
VITE_RPC_URL=http://127.0.0.1:8899
VITE_NETWORK=localnet
# After anchor keys sync and npm run sync:idl:
VITE_PROGRAM_ID=
# Public address of your test SPL mint (classic Token Program only).
VITE_TEST_MINT=

# Separate DeFi connection: Devnet only, independent of escrow Localnet.
VITE_DEFI_RPC_URL=https://api.devnet.solana.com
# Real pool ID printed by npm run defi:setup
VITE_DEFI_POOL_ID=
